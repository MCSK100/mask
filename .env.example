# --- ShadowMeet frontend ---
# Socket + REST signaling server (REQUIRED for meetings).
# Local dev: http://localhost:5000 | Prod: your Render/Railway/Fly URL (NOT the Vercel URL)
VITE_SOCKET_URL=http://localhost:5000

# Public site URL
# VITE_SITE_URL=https://shadowmeet.vercel.app

# WebRTC TURN (required for cross-network video; STUN alone fails on symmetric NAT)
# VITE_TURN_URLS=turn:your-turn-host:3478?transport=udp,turn:your-turn-host:3478?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Feature flags (true/false)
VITE_FEATURE_YOUTUBE=true
VITE_FEATURE_MUSIC=true
VITE_FEATURE_WHITEBOARD=true
VITE_FEATURE_RECORDING=true
VITE_FEATURE_STREAMING=false
VITE_FEATURE_POLLS=true
VITE_FEATURE_FILES=true
VITE_FEATURE_CLASSROOM=true
