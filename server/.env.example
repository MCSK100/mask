PORT=5000
# Comma-separated in production. MUST include every frontend origin or browsers
# block all API calls (CORS preflight fails with no Access-Control-Allow-Origin).
# No trailing slashes. e.g. https://onespace-live.vercel.app
CORS_ORIGIN=http://localhost:5173
# Max participants per room (LiveKit SFU; selective subscription keeps large classes fast)
MAX_PARTICIPANTS=50

# --- LiveKit (REQUIRED for media) ---
# Public WebSocket URL handed to clients (e.g. wss://your-livekit.example)
LIVEKIT_URL=
# Key ID (public) + secret (NEVER expose to browser; server-only)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Canonical frontend origin for links/CORS checks
FRONTEND_URL=http://localhost:5173
# Optional Postgres/Supabase URL (see db-schema.sql); in-memory store is used when unset
DATABASE_URL=
