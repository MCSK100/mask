{
  "id": "/",
  "name": "Shadowchaty — Anonymous Stranger Chat",
  "short_name": "Shadowchaty",
  "description": "Free random video & text chat with strangers. No signup. Talk to people worldwide instantly.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#020617",
  "theme_color": "#020617",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["social", "lifestyle", "communication"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/shadowchaty-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shadowchaty-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shadowchaty-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/shadowchaty-favicon.jpg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Text Chat",
      "short_name": "Text Chat",
      "description": "Start an anonymous text chat instantly",
      "url": "/chat?source=shortcut",
      "icons": [{ "src": "/shadowchaty-favicon.jpg", "sizes": "96x96", "type": "image/jpeg" }]
    },
    {
      "name": "Start Video Chat",
      "short_name": "Video Chat",
      "description": "Start a random video chat instantly",
      "url": "/video?source=shortcut",
      "icons": [{ "src": "/shadowchaty-favicon.jpg", "sizes": "96x96", "type": "image/jpeg" }]
    }
  ]
}
